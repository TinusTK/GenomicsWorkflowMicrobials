// Settings shared by every compiled workflow (the workflow's own steps,
// settings and databases are in its params.config).

manifest {
    name            = 'NTGPathologyGenomicsWorkflowPipeline'
    description     = 'Stand-alone Nextflow version of the Galaxy Australia workflow "Genomic Assembly and analysis - RDH version 5.2"'
    version         = '1.0.0'
    nextflowVersion = '>=25.04.0'
    mainScript      = 'main.nf'
}

params {
    // Folder of paired reads; sample name = everything before _R1 / _R2
    input   = 'fastq'
    // Or a CSV (sample,r1,r2) with the pairs already made: the UI writes one per run
    samplesheet = ''
    outdir  = 'results'
    db_dir  = "${System.getenv('NTG_DB_DIR') ?: System.getenv('HOME') + '/.ntg/databases'}"

    // Delete the work folder (intermediate files of every step) after a
    // successful run. Saves a lot of disk space, but -resume no longer works
    // and the intermediate files are gone. Final results in outdir are kept.
    // Off by default so labs keep everything for traceability.
    cleanup = false

    // Limits for this computer, for all running steps together. 0 = detect:
    // every CPU thread, and total RAM minus 4 GB so the desktop and browser keep
    // room (otherwise systemd-oomd can kill things mid-run).
    max_cpus      = 0
    max_memory_gb = 0
}

// toString(): "--cleanup false" on the command line arrives as the text 'false'
cleanup = params.cleanup.toString() == 'true'

// No `def` variables here: Nextflow's strict config parser (default from
// 25.10) rejects them next to config statements, so the defaults are inline.
// executor: how much the steps running at the same time may use together
// (Nextflow waits to start a step until enough is free). resourceLimits: the
// most a single step may ask for.
executor {
    cpus   = (params.max_cpus as int) ?: Runtime.runtime.availableProcessors()
    memory = "${(params.max_memory_gb as int) ?: Math.max(2, ((java.lang.management.ManagementFactory.operatingSystemMXBean.totalMemorySize / 1073741824) as int) - 4)} GB"
}
process {
    resourceLimits = [
        cpus:   (params.max_cpus as int) ?: Runtime.runtime.availableProcessors(),
        memory: "${(params.max_memory_gb as int) ?: Math.max(2, ((java.lang.management.ManagementFactory.operatingSystemMXBean.totalMemorySize / 1073741824) as int) - 4)} GB"
    ]
}

profiles {
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
    }
}

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${new Date().format('yyyyMMdd-HHmmss')}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${new Date().format('yyyyMMdd-HHmmss')}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${new Date().format('yyyyMMdd-HHmmss')}.tsv" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${new Date().format('yyyyMMdd-HHmmss')}.html" }
