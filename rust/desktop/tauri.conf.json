{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Genomics Workflow Microbials",
  "version": "2.0.5",
  "identifier": "io.github.tinustk.genomicsworkflowmicrobials",
  "build": {
    "frontendDist": "../gui/dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix gui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Genomics Workflow Microbials",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "TinusTK",
    "category": "Utility",
    "shortDescription": "Bacterial isolate typing from paired reads",
    "longDescription": "Assembly, MLST, serovar, emm type, AMR and quality checks of bacterial isolates from paired Illumina reads, with every tool in its own pinned container.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../../tools/": "tools/",
      "../../workflows/": "workflows/",
      "../../databases/": "databases/",
      "../../recipes/": "recipes/",
      "bin/": "bin/",
      "wsl/": "wsl/"
    },
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNEFDMkRCRUNCMkMwNEMKUldSTXdMTHMyOEpLM0pXTWtGRmxGMW1GcmtOb0ozS2wxUFBodEl5SHF6dnJvM3cza1dhWXBzS2UK",
      "endpoints": ["https://github.com/TinusTK/GenomicsWorkflowMicrobials/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
