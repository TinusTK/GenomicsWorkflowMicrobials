#!/usr/bin/env bash
# Version 1 (the browser app run with ./ntg) has ended. An old version 1
# install that updates itself lands here: this tells its user where to go.
echo "Genomics Workflow Microbials is now a desktop app (version 2)."
echo "Download the installer for your computer from:"
echo "  https://github.com/TinusTK/GenomicsWorkflowMicrobials/releases/latest"
echo "Your workflows, databases and results from version 1 are kept."
read -r -t 60 -p "Press Enter to close. " _ || true
